{
  "endpoint": "https://demo-endpoint-vercel.vercel.app/query",
  "manifold": "cascadia",
  "contract_version": "3",
  "queries": [
    {
      "id": "clarify",
      "label": "the average of aov, by year \u2014 averaged from which grain?",
      "frameql": "SELECT avg(aov) AT {cal.year}",
      "universe": null,
      "intended": "clarify"
    },
    {
      "id": "refuse",
      "label": "stock summed to months, by store \u2014 but stock doesn't sum across time",
      "frameql": "SELECT stock.sum AT {store*cal.month}",
      "universe": null,
      "intended": "refuse"
    },
    {
      "id": "disclose",
      "label": "distinct buyers, by month \u2014 counted from a sketch",
      "frameql": "SELECT buyers AT {cal.month}",
      "universe": null,
      "intended": "disclose"
    },
    {
      "id": "serve",
      "label": "average order value (aov), by month",
      "frameql": "SELECT aov AT {cal.month}",
      "universe": null,
      "intended": "serve"
    }
  ],
  "foolIt": {
    "placeholder": "profit_margin",
    "template": "SELECT %s AT {cal.month}"
  }
}
