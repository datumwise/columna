---
/**
 * SIGNPOST ONLY — this is not the rebuilt Columna surface.
 *
 * Slice 1 introduces the four-door shell but explicitly does NOT authorize rebuilding /columna
 * (implementation brief §11). Rather than 404 the door or migrate any route, this gathers the
 * Columna material that is already live and unchanged. It is expected to be replaced wholesale by
 * the Columna-as-system slice.
 *
 * The upward-framing line at the end is the bidirectional rule in miniature: a product surface
 * points back to the principle that explains why the behaviour exists (positioning §11).
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const DOORS = [
  { href: '/install', label: 'Install and run the demo',
    blurb: 'a clarify, a refuse and a disclose print on your own machine, as wire JSON.' },
  { href: '/learn', label: 'Learn the framework',
    blurb: 'what Columna, Frame-QL and a Manifold are — and the three manuals.' },
  { href: '/explorer', label: 'The Manifold Explorer',
    blurb: 'browse a real published Manifold: universes, measures, verdicts.' },
  { href: '/docs/frameql', label: 'The Frame-QL manual',
    blurb: 'the language of governed meaning, in full.' },
  { href: '/case', label: 'The worked case',
    blurb: 'a realistic warehouse, the Manifold that serves it, and recorded agent transcripts.' },
  { href: 'https://github.com/datumwise/columna', label: 'GitHub', external: true,
    blurb: 'Apache-2.0, open source.' },
];
---
<BaseLayout
  title="Columna — datumwise"
  description="Columna is an open-source analytical system in which governed meaning, not physical procedure, determines what may be served."
  chip={false}
>
  <h1 class="ds-proposition">Columna</h1>

  <p class="ds-body">
    Columna is an open-source analytical system in which governed meaning — not physical procedure —
    determines what may be served.
  </p>

  <p class="ds-body">The full Columna surface is being rebuilt. Everything it will gather is already live:</p>

  <ul class="doors">
    {DOORS.map((d) => (
      <li>
        <a href={d.href} {...(d.external ? { rel: 'noopener', target: '_blank' } : {})}>{d.label}</a>
        <span class="blurb"> — {d.blurb}</span>
      </li>
    ))}
  </ul>

  <p class="ds-body note">
    These behaviours are not product personality. They follow from the rule that absence of
    contradiction is not permission. <a href="/analytical-governance">Analytical Governance →</a>
  </p>
</BaseLayout>

<style>
  h1 { margin: 3rem 0 2rem; }
  .ds-body { margin: 0 0 1.25rem; }
  .doors { list-style: none; padding: 0; margin: 0 0 2rem; }
  .doors li { padding: 0.7rem 0; border-bottom: 1px solid var(--rule); }
  .doors a { color: var(--ink); }
  .blurb { font-family: var(--font-serif); color: var(--ink-soft); }
  .note { color: var(--ink-faint); border-top: 1px solid var(--rule); padding-top: 1.25rem; }
</style>
