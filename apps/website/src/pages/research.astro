---
// /research — THE CURRENT REPRESENTATIVE RESEARCH CORPUS.
//
// NARROWED 2026-08-25 (Huayin). This route no longer renders every catalogued source. Its job is
// the body of works through which datumwise CURRENTLY STATES AND EXPLAINS its intellectual
// position — deliberately narrower than the publication record, the public website, Ask's
// reference material, the technical documentation, the evidence, and the teaching surfaces.
// Membership is ruled in registry/sources/current-corpus.json and gated fail-closed.
//
// REFERENCE ONLY sources are NOT rendered here, and deliberately NOT as a second section beneath —
// that would recreate the exhaustive source estate under another name. They remain public at their
// own routes and reachable through Ask when a question calls for their jurisdiction.
//
// WHAT THIS ROUTE IS NOW (Huayin, 2026-08-25, Serious Gateway 1). The governing principle: current
// reality owns the primary addresses; historical reality gets permanent, explicit historical
// addresses. This route used to render a map written on 3 August 2026 and byte-frozen since — a page
// that told a reader, in the present tense, that The Theory of Data was at Version 4.0. It is at
// v6.1. The map is preserved unchanged at /history/research-map-2026-08-03; this address now answers
// the question a reader actually brings to it: what is the serious estate NOW.
//
// READER-PULLED, NOT GUIDED. A serious reader usually arrives with something already in their head —
// "where is ToD v6.1", "what is the current Primer", "show me the Statistical Bridge", "what do you
// know is wrong". So this page is a dense scan, not a tour: no hero, no progressive reveal, no
// narrative, no equal card grid, and no JavaScript. Groups exist to accelerate scanning; they are
// not doors and they are not equal.
//
// EVERY PUBLICATION FACT IS DERIVED. The catalog at registry/sources/sources.json holds identity,
// role, purpose, route and FOREIGN KEYS — never a title of a deposited record, a version, a date, a
// DOI or a currency claim. Those are read at render time through currentRecord(workId) and
// recordFor(recordId). This file types none of them, which is what makes it safe as a `derived`
// surface under G7. The publication registry owns publication truth; this page is a view over it.
//
// NO COUNT IS RENDERED, anywhere, deliberately. works.json.kind stays `unclassified` for all 32
// works, COUNTS_ARE_DERIVABLE stays false, and G10 keeps blocking count claims. The source catalog
// classifies SOURCES by role; it does not classify WORKS, so it opens no back door to a count.
//
// EDITION-PINNED ROUTES ARE A FEATURE. Several routes render a byte-faithful deposited edition by
// ruling. Where the registry's current record has moved past the edition a route renders, the row
// says both — current record vX, readable here vY — with every number derived. An edition-pinned
// route is not stale and it is not current: it is pinned, and the reader is told which.
//
// THE LEGACY FRAGMENT SHIM. Eight heading anchors existed inside the frozen map and have been live
// and sitemap-indexed since 3 August: #the-root, #the-kernel-what-is-proved, #the-bridges,
// #the-positions, #the-ripples, #the-instruments, #the-engine-is-the-proof, #four-ways-in. A
// fragment never reaches the server, and this repo's redirects are meta-refresh stubs which do not
// carry one — so a shim forwards exactly those eight to the same anchor on the historical route.
// Fragmentless /research is NOT redirected: it belongs to current reality now. Same pattern as the
// #exhibit-a/#exhibit-b shim on the homepage.
import BaseLayout from '../layouts/BaseLayout.astro';
import { REPRESENTATIVE, GROUPS, actions, type ResolvedSource } from '../data/sources';
import { longDate } from '../data/publications';

// The composed standing line. There is no `standing` enum: a source can be deposited AND onsite,
// generated AND onsite, preserved AND onsite (Huayin's refinement). So the orthogonal facts are
// composed into a sentence here, at the point of display, and nothing is asserted by absence.
function standing(s: ResolvedSource): string[] {
  const bits: string[] = [];
  if (s.current) {
    bits.push(
      `current record${s.current.version ? ` v${s.current.version}` : ''} · ${longDate(s.current.date)}`
    );
    // "deposit only — not readable here" was true fourteen times on this page until 2026-08-27,
    // and it was the site's most honest sentence and its worst one. The reading surface makes the
    // deposited text readable on this domain; the deposit remains the record either way.
    if (!s.route && !s.readingRoute) bits.push('deposit only — not readable here');
    else if (!s.route && s.readingRoute) bits.push('the deposited text is readable here in full');
  }
  if (s.generatedBy) bits.push(`generated by ${s.generatedBy}`);
  if (s.gates?.includes('build-adjudicated')) bits.push('the build fails if the displayed claim drifts');
  if (s.gates?.includes('currency-stamp')) bits.push('currency-stamped against the shipped package');
  if (s.preservedState) bits.push(`preserved state of ${longDate(s.preservedState)}`);
  return bits;
}

// A row prints its role only where the group merges more than one — inside "Positions" every row is
// a position, and repeating the word on each is noise pretending to be metadata.
const groups = GROUPS.map((g) => ({
  ...g,
  showRole: g.roles.length > 1,
  rows: REPRESENTATIVE.filter((s) => g.roles.includes(s.role)),
})).filter((g) => g.rows.length > 0);

// Every catalog entry must land in exactly one group, or the page silently loses a source.
const placed = groups.reduce((n, g) => n + g.rows.length, 0);
if (placed !== REPRESENTATIVE.length) {
  const seen = new Set(groups.flatMap((g) => g.rows.map((r) => r.sourceId)));
  throw new Error(
    `RESEARCH: ${REPRESENTATIVE.length - placed} source(s) fell out of every group — ` +
    `${REPRESENTATIVE.filter((s) => !seen.has(s.sourceId)).map((s) => `${s.sourceId} (${s.role})`).join(', ')}. ` +
    `Add the role to a group in src/data/sources.ts. A source that renders nowhere is worse than one with a clumsy heading.`
  );
}
---
<BaseLayout
  title="Research — the current source estate — datumwise"
  description="The datumwise research and source estate as it is now: the deposited works and their current records, the normative references, the machine evidence, the teaching surfaces, and the public negative record."
  wide={true}
  chip={false}
>
  <div class="head">
    <p class="kicker mono">Research</p>
    <h1 class="head-h">The current research corpus</h1>
    <p class="head-p">
      The works through which datumwise states and explains its position now — what each one is,
      what authority it carries, and whether you can read it here. Versions, dates and deposit
      records are read from the publication registry when this page is built; nothing on it is
      typed by hand.
    </p>
    <p class="head-p head-quiet">
      This is narrower than everything datumwise has published and narrower than everything on this
      site. The manuals govern the shipped system, <a href="/case">the Case</a> records what the
      implementation demonstrably did, <a href="/known-issues">known issues</a> records what is
      presently broken, and <a href="/start-here">the teaching surfaces</a> explain the work — each
      authoritative for its own subject, none of them part of the corpus below. The complete
      deposited record is preserved in the publication registry.
    </p>
    <p class="head-p head-quiet">
      Looking for the research map as it was written in August 2026? It is preserved, unchanged, at
      <a href="/history/research-map-2026-08-03">the research map, 3 August 2026</a>.
    </p>
  </div>

  {groups.map((g) => (
    <section class="grp" aria-labelledby={`g-${g.title.replace(/\W+/g, '-').toLowerCase()}`}>
      <div class="grp-head">
        <h2 id={`g-${g.title.replace(/\W+/g, '-').toLowerCase()}`} class="grp-h">{g.title}</h2>
        <p class="grp-blurb">{g.blurb}</p>
      </div>

      <ul class="rows">
        {g.rows.map((s) => (
          <li class="row" id={s.sourceId}>
            <div class="row-main">
              <h3 class="row-title">{s.label}</h3>
              <p class="row-purpose">{s.purpose}</p>
              {s.editionDiffers && s.readable && s.current && (
                <p class="row-pin">
                  <span class="pin-mark mono">edition-pinned</span>
                  <span>This site renders the deposited <strong>{s.readable.version ? `v${s.readable.version}` : 'first'} edition</strong> ({longDate(s.readable.date)}) — the edition this page was built from. The current record is <strong>{s.current.version ? `v${s.current.version}` : 'a later edition'}</strong>.{s.current.title !== s.readable.title && <span> The onsite edition was deposited under its earlier title, <em>{s.readable.title}</em>.</span>}</span>
                </p>
              )}
            </div>

            <div class="row-side">
              {g.showRole && <p class="row-role mono">{s.role.replace(/-/g, ' ')}</p>}
              {standing(s).map((b) => <p class="row-standing mono">{b}</p>)}
              <p class="row-actions">
                {actions(s).map((a) => (
                  <a class="act" href={a.href} rel={a.href.startsWith('http') ? 'noopener' : undefined}>{a.label}</a>
                ))}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <p class="foot-note">
    Publication truth is owned by the publication registry, not by any page that renders it. Where a
    work is deposited, <strong>Record</strong> goes to the deposit; where it can be read here,
    <strong>Read</strong> goes to the text. Anything absent from this page is absent because it is
    not yet a source a reader can be sent to, not because it is hidden.
  </p>
</BaseLayout>

<script>
  // LEGACY FRAGMENT SHIM. The eight anchors that lived inside the frozen research map, forwarded to
  // the same anchor on its permanent historical address. A fragment never reaches the server and a
  // meta-refresh stub does not carry one, so this is the only mechanism that preserves a reader's
  // target. Fragmentless /research is deliberately NOT redirected.
  const LEGACY = new Set([
    '#the-research-corpus', '#the-root', '#the-kernel-what-is-proved', '#the-bridges',
    '#the-positions', '#the-ripples', '#the-instruments', '#the-engine-is-the-proof',
    '#four-ways-in',
  ]);
  if (LEGACY.has(location.hash)) {
    location.replace('/history/research-map-2026-08-03' + location.hash);
  }
</script>

<style>
  /* Calm, dense, scannable. No hero, no cards, no reveal. Hairlines and space do the separating. */
  .head { width: min(100% - 3rem, 60rem); margin: 0 auto; padding-block: clamp(1.5rem, 1rem + 2vw, 2.75rem) 0; }
  .mono { font-family: var(--font-mono); }
  .kicker { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-faint); margin: 0; }
  .head-h { font-family: var(--font-serif); font-size: clamp(1.7rem, 1.2rem + 1.9vw, 2.5rem);
    font-weight: 400; letter-spacing: -0.02em; margin: 0.5rem 0 0.9rem; }
  .head-p { max-width: 40rem; font-size: 0.98rem; line-height: 1.6; color: var(--ink); margin: 0 0 0.7rem; }
  .head-quiet { color: var(--ink-soft); font-size: 0.92rem; }

  .grp { width: min(100% - 3rem, 60rem); margin: 0 auto; padding-top: clamp(2.25rem, 1.5rem + 2vw, 3.25rem); }
  .grp-head { border-bottom: 1px solid var(--ink); padding-bottom: 0.6rem; }
  .grp-h { font-family: var(--font-serif); font-size: 1.2rem; font-weight: 400; margin: 0; }
  .grp-blurb { font-size: 0.88rem; line-height: 1.55; color: var(--ink-soft); margin: 0.35rem 0 0; max-width: 44rem; }

  .rows { list-style: none; margin: 0; padding: 0; }
  .row {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 17rem);
    gap: 0.75rem 2.5rem; align-items: start;
    padding: 1.05rem 0; border-bottom: 1px solid var(--rule);
  }
  .row-title { font-family: var(--font-serif); font-size: 1.06rem; font-weight: 400; margin: 0; line-height: 1.3; }
  .row-purpose { font-size: 0.92rem; line-height: 1.55; color: var(--ink-soft); margin: 0.3rem 0 0; max-width: 40rem; }

  /* The edition-pinned note is the one place a row gets loud, because it is the one place a reader
     could otherwise be quietly misled about which edition they are reading. */
  .row-pin { font-size: 0.86rem; line-height: 1.55; color: var(--ink); margin: 0.55rem 0 0;
    border-left: 2px solid var(--rule-strong); padding-left: 0.7rem; max-width: 40rem; }
  .pin-mark { display: block; font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-faint); margin-bottom: 0.15rem; }

  .row-side { display: grid; gap: 0.3rem; }
  .row-role { font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-faint); margin: 0; }
  .row-standing { font-size: 0.72rem; line-height: 1.5; color: var(--ink-soft); margin: 0; }
  .row-actions { margin: 0.25rem 0 0; display: flex; gap: 0.9rem; flex-wrap: wrap; }
  .act { font-family: var(--font-sans); font-size: 0.85rem; color: var(--ink);
    border-bottom: 1px solid var(--rule-strong); text-decoration: none; }
  .act:hover { border-bottom-color: var(--ink); }

  .foot-note { width: min(100% - 3rem, 60rem); margin: clamp(2.5rem, 2rem + 2vw, 4rem) auto 0;
    padding-top: 1.2rem; border-top: 1px solid var(--rule);
    font-size: 0.86rem; line-height: 1.6; color: var(--ink-soft); max-width: 44rem; }

  @media (max-width: 52rem) {
    .row { grid-template-columns: 1fr; gap: 0.5rem; }
    .row-side { padding-top: 0.15rem; }
    .row-role { order: -1; }
  }
</style>
