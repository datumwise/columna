---
// /positions — the Positions section index. Framing line is RATIFIED copy, verbatim.
//
// Each entry stamps the date + version, transcribed from the piece's OWN byline ("A position held by
// datumwise · July 2026 · v1.0"). SETTLED (Huayin's 2026-07-25 ruling 2): bylines are the public truth,
// filenames are desk lineage — so the positions publish as v1.0 exactly as their bylines read, and the
// v1_1 filenames stay as lineage. /positions is the only surface that constitutionally wears dates and
// versions; the what-is series is explanatory and undated.
import BaseLayout from '../../layouts/BaseLayout.astro';

const FRAMING = 'Positions we hold, stated plainly and linked to their evidence. When the evidence moves, the position moves — with a note.';

const positions = [
  {
    href: '/positions/never-let-your-agent-touch-the-database',
    title: 'Never Let Your Agent Touch the Database',
    stamp: 'August 2026 · v1.1',
    // Verbatim from the v1.1 paper edition (measure migration swap, 2026-08-03) — its thesis line.
    pull: 'Treat the model as an untrusted searcher. Put a small, deterministic, governed boundary between the model and the database.',
  },
  {
    href: '/positions/the-two-great-sources-of-silent-analytical-failure',
    title: 'The Two Great Sources of Silent Analytical Failure',
    stamp: 'July 2026 · v1.0',
    // Verbatim from the piece's "The claim, in one breath".
    pull: 'Every silent failure is the unrecorded resolution of a name across a degree of freedom, and the freedoms number four.',
  },
  // The two foundations positions. Practice-needs was SWAPPED to its v1.1 paper edition in the
  // 2026-08-03 measure migration (byline "Version 1.1 · 3 August 2026") — so its stamp reads v1.1 and
  // its pull is verbatim from that paper. Row/Table/Join is the DISTINCT site edition (swept in place,
  // not swapped): its byline keeps 2026-07-30, so its stamp stays the date only and its pull is intact.
  {
    href: '/positions/practice-needs-a-theory',
    title: 'Practice Needs a Firmer Foundation',
    stamp: 'August 2026 · v1.1',
    // Verbatim from the v1.1 paper edition — its narrower claim, stated plainly.
    pull: 'Our current foundations do not provide a complete, executable account of analytical meaning and lawful transformation.',
  },
  {
    href: '/positions/row-table-join-no-longer-primitives',
    title: 'Row, Table, Join: No Longer Primitives',
    stamp: 'July 2026',
    // Verbatim — the piece's bolded thesis sentence (site edition, swept in place).
    pull: 'At the theoretical foundation, row, table, and join are no longer primitives — they are projections of another world’s primitives.',
  },
];
---
<BaseLayout title="Positions — datumwise"
  description="Positions datumwise holds, stated plainly and linked to their evidence. When the evidence moves, the position moves — with a note.">
  <div class="page-head">
    <p class="kicker">Positions</p>
    <h1 class="serif">Positions</h1>
    <p class="lede">{FRAMING}</p>
  </div>

  <section class="doctrine">
    <h2>The doctrine</h2>
    <p class="doctrine-framing">The stances below rest on a doctrine. It has four short statements.</p>
    <p class="doctrine-links">
      <a href="/thesis">The Thesis</a> · <a href="/why">Why</a> · <a href="/ladder">The Ladder</a> · <a href="/the-argument">The Argument</a>
    </p>
  </section>

  <ul class="positions-list">
    {positions.map((p) => (
      <li>
        <a class="p-title" href={p.href}>{p.title}</a>
        <p class="p-stamp mono">{p.stamp}</p>
        <p class="p-pull">{p.pull}</p>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .page-head { width: min(100% - 3rem, 46rem); margin: 0 auto; }
  .page-head h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); margin: 0.3rem 0 0.8rem; }
  .lede { font-size: 1.05rem; color: var(--ink-soft); max-width: 38rem; }

  .doctrine { width: min(100% - 3rem, 46rem); margin: 2.4rem auto 0;
    padding-top: 1.4rem; border-top: 1px solid var(--rule); }
  .doctrine h2 { font-family: var(--font-sans); font-size: 0.95rem; font-weight: 600;
    letter-spacing: 0.02em; margin: 0 0 0.4rem; color: var(--ink); }
  .doctrine-framing { margin: 0; font-size: 0.95rem; color: var(--ink-soft); }
  .doctrine-links { margin: 0.5rem 0 0; font-size: 0.95rem; }
  .doctrine-links a { color: var(--ink); text-decoration: underline;
    text-decoration-color: var(--rule-strong); }
  .doctrine-links a:hover { text-decoration-color: var(--ink-faint); }

  .positions-list {
    width: min(100% - 3rem, 46rem); margin: 2.6rem auto 0;
    list-style: none; padding: 0; display: grid; gap: 2.2rem;
  }
  .positions-list li { display: grid; gap: 0.35rem;
    padding-top: 1.4rem; border-top: 1px solid var(--rule); }
  .p-title { font-family: var(--font-sans); font-size: 1.15rem; font-weight: 600; color: var(--ink);
    text-decoration: underline; text-decoration-color: var(--rule-strong); width: fit-content; }
  .p-title:hover { text-decoration-color: var(--ink-faint); }
  .p-stamp { margin: 0; font-size: 0.75rem; color: var(--ink-faint); letter-spacing: 0.02em; }
  .p-pull { margin: 0.35rem 0 0; font-family: var(--font-serif); font-size: 1.02rem;
    line-height: 1.6; color: var(--ink-soft); max-width: 34rem; }
</style>
