---
// THE HOMEPAGE (v2). The lobby, not the argument (copy spec §law 2): it DESCRIBES and POINTS; the
// boldness lives in /the-argument, /positions, /thesis, linked plainly from here. Every block is
// state, utility, or directory — never prose that must be re-read (copy spec §law 1). Section order is
// deliberate: identity → description → state → utility → directory → who we are.
//
// Ink-only, no saturated colour, no cards (art direction). Separation is hairline rules + whitespace.
// The one visual object is the hero manifold, generated from the shipped package at build time.
import BaseLayout from '../layouts/BaseLayout.astro';
// ── THE FRONT GATE ───────────────────────────────────────────────────────────────────────────
// Bearing (PAPER) · one standing encounter (PAPER → WIRE, where the encounter earns it). That is
// the whole front gate. Everything below the legacy edge is the previous homepage, retained
// deliberately and untouched by this unit.
//
// THE RULING THIS IMPLEMENTS (Huayin + CG2, 2026-08-25, front-gate Unit A):
//   serious institutional bearing → one encounter at full strength → whatever reply that
//   encounter honestly earns.
//
// SUPERSEDED by the homepage laboratory, and recorded here so it is not quietly restored:
//   · the Three Questions composition (implementation brief §8) — three short explanations cannot
//     carry three foundations before a reader has experienced any of them. Gate H2 (pillar
//     integrity) retires with it, replaced by: the terrain names are present, distinct, carry no
//     explanatory apparatus, and are not links.
//   · Hero as the opening (§7) — PARTIALLY. Its identity statement survives as Bearing; its
//     commitment block, action links and lattice do not.
//   · the Hero → Three Questions → Exhibit A composition target (§10).
// RETAINED: four doors, paper/wire grammar, visible crossing, mood authority, machine legibility,
// accessibility, and gates H1 and H3–H8 as the standing encounter-review gates.
//
// NOT extracted: an encounter component system. The encounter is a hand-built file with no props,
// and the next one will disagree with it about everything except honesty.
//
// THE FOUR-MOOD WITNESS HAS LEFT THIS PAGE (Unit B, 2026-08-25). The homepage used to carry a
// second, competing thesis after the encounter finished — an Exhibit A block opening at display
// scale with a fresh grand claim, which read as the page starting over. The witness is now
// consolidated at /the-argument#exhibit-b, where the paper Exhibit A already sets it up, and the
// obligation that pinned it here is discharged: `#try-a-question` and `#exhibit-a-heading` are
// re-pointed at their 11 call sites, and the shim below catches anything bookmarked.
// The encounter earns its own reply and nothing mandatory follows it.
import Bearing from '../components/home/Bearing.astro';
import Umbrella from '../components/encounters/umbrella.astro';
import { LATEST, PACKAGE_VERSION } from '../data/latest.ts';

const shortDate = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });

// §5 is an ORDERED PATH, not a flat list (Huayin's first-read ruling): the items sequenced as the
// ladder a reader actually climbs, opened by an UNNUMBERED entrance that carries the "start here"
// mark. This is also what fixes /the-argument's reachability STRUCTURALLY — it is reached by readers
// who have already been convinced, which is who it was written for.
//
// THE ENTRANCE MOVED (Huayin, 2026-08-24, Homepage Mission Step 2). Repair Unit 4 landed
// /start-here as the site's cold-reader surface, and the ruling is that /start-here now owns the
// public "start here" role outright. So the mark moves off the position piece and onto the route
// that earned it; the position stays on the ladder, as a position, because only its ROLE changed.
// Two surfaces claiming "start here" was the contradiction this repairs.
//
// NO PUBLICATION FACT IS AUTHORED HERE. The Afternoon is a local teaching artifact with no DOI, no
// Zenodo record, and no version this page may assert (see start-here.astro and learn.astro) — so the
// entrance names the artifact and what it does for the reader, and nothing else. index.astro is a
// `derived` surface under G7 and is NOT enrolled in the currency stamps, which means a typed version
// string here would be caught by nobody: do not add one.
const DIRECTORY = [
  { title: 'The Theory of Data in One Afternoon', href: '/start-here', mark: 'start here',
    blurb: 'the whole idea in one sitting, from a cold start — the failures you have already debugged, the world they imply, and the queries that fall out of them. No prior reading needed.' },
  { title: 'Never Let Your Agent Touch the Database', href: '/positions/never-let-your-agent-touch-the-database',
    blurb: 'the position: why the model should never hold your database credentials, and what to put between them.' },
  { title: 'Run the demo', href: '/install', blurb: 'install, and a clarify, a refuse, and a disclose print on your machine as wire JSON.' },
  { title: 'Read the case', href: '/case', blurb: 'a complete worked example: a realistic warehouse, the Manifold that serves it, and recorded agent transcripts.' },
  { title: 'Learn the framework', href: '/learn', blurb: 'what Columna, FrameQL, and a Manifold are; the three manuals; the live Explorer.' },
  { title: 'Read the argument', href: '/the-argument', blurb: 'the eight-minute case for why this exists, with two live exhibits.' },
  { title: 'Positions', href: '/positions', blurb: 'every stance we hold, with its evidence and its paper edition.' },
  // CORRECTED (Huayin, 2026-08-24, Homepage Mission Step 2). This blurb used to promise "every paper,
  // one map, every claim one click from its DOI" — a running-index claim. Repair Unit 3 made the
  // page's real contract visible: /research is a PRESERVED SNAPSHOT, deliberately frozen, and the
  // authority for current publication records is /about. The old wording outlived the repair by one
  // route and nothing gated it. Plain language, no DOI, no version, no count (G7 and G10).
  { title: 'The research corpus', href: '/research', blurb: 'the research entrance: a preserved map of the corpus, from the failure atlas to the proved kernel. It is a snapshot, not a running index — About carries the current publication records.' },
];
---
<BaseLayout
  title="datumwise — First Principles: Analytics"
  description="datumwise develops first-principles foundations, languages, and systems for analytics across data, evidence, and intelligence. Built so that no layer can silently return a confident wrong number."
  wide={true}
  chip={false}
>

  <Bearing />
  <Umbrella />

  {/* ── LEGACY BOUNDARY ───────────────────────────────────────────────────────────────────────
      Everything below this line is the PREVIOUS homepage, untouched by this unit and not rewritten
      to the new grammar. It is kept so the page still functions for visitors while the front gate
      is under review; it is not an endorsement of its sequencing. The cleanup is a later slice.

      ONE WIRE BLOCK ON THIS PAGE, and the encounter earned it. Exhibit A left in Unit B.
      ────────────────────────────────────────────────────────────────────────────────────────── */}
  <hr class="legacy-edge" aria-hidden="true" />

  {/* 2 · What Columna is — the page's one long-form block; reading serif, capped measure. */}
  <section class="whatis band">
    <div class="prose-col">
      <p>Columna has three parts. The <strong>Manifold</strong> is a data model that holds what your data means — declared by a person, then checked against the data itself before it serves. <strong>FrameQL</strong> is a query language that can only ask for meaning the Manifold declares. The <strong>engine</strong> serves nothing the model can't defend. Behind the model stands a published theory with a proved kernel — a growing fragment of its laws are machine-checked theorems, not house style.</p>
      <p>Every answer comes back in one of four moods: <span class="mood mood-serve">serve</span> (the number), <span class="mood mood-disclose">disclose</span> (the number and the assumptions it rides on), <span class="mood mood-clarify">clarify</span> (the question has more than one legitimate answer — choose), or <span class="mood mood-refuse">refuse</span> (the data does not define this — here's why). The same contract reaches a Python caller, an HTTP client, and an AI agent over MCP.</p>
      <p class="whatis-meta">It is Apache-2.0, developed in the open, and currently at {PACKAGE_VERSION}.</p>
    </div>
  </section>

  <hr class="rule" />

  {/* 3 · Latest — the state rail, wired from data. Reads as a ledger line, not a card grid. */}
  <section class="latest band" aria-labelledby="latest-h">
    <p class="rail-label mono" id="latest-h">latest</p>
    <ul class="rail">
      {LATEST.map((it) => (
        <li class="rail-item">
          <span class="rail-kind mono">{it.kind}</span>
          <a href={it.href} {...(it.external ? { rel: 'noopener', target: '_blank' } : {})}>{it.title}</a>
          <span class="rail-date">{shortDate(it.date)}</span>
        </li>
      ))}
    </ul>
  </section>

  <hr class="rule" />

  {/* 5 · Where to go — the directory. Seven doors, described not sold. */}
  <section class="directory band" aria-labelledby="dir-h">
    <h2 id="dir-h" class="section-h prose-col">Where to go</h2>
    <p class="dir-lede prose-col">In the order a reader usually wants them.</p>
    <ol class="dir-list">
      {DIRECTORY.map((d, i) => (
        <li class={d.mark ? 'dir-item dir-entrance' : 'dir-item'}>
          {/* The ENTRANCE is deliberately UNNUMBERED (Huayin's numbering ruling (b)): it carries only
              "start here", so it reads as distinct from the path it opens.
              NOTE, 2026-08-24: the entrance is now /start-here and the position it displaced became a
              numbered rung, so the ladder runs 1–7 and /the-argument sits at rung 5 where it used to
              sit at rung 4. Numbering ruling (b) fixed the entrance's UNNUMBERED-ness, which still
              holds; it also observed the argument's rung, which has shifted by one. Flagged for
              review rather than silently re-ordered — holding the argument at 4 would mean moving the
              position piece down the ladder, which is a structural edit this unit is not authorized
              to make. */}
          <span class="dir-rung mono">{d.mark ? '' : i}</span>
          <div class="dir-body">
            <a class="dir-title" href={d.href}>{d.title}</a>
            {d.mark && <span class="dir-mark mono">{d.mark}</span>}
            <span class="dir-blurb">{d.blurb}</span>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <hr class="rule" />

  {/* 6 · About the project */}
  <section class="about-block band">
    <div class="prose-col">
      <p>datumwise builds and stewards Columna: Huayin Wang (research), Irena Wang (engineering). It is an independent open-source research project.</p>
      <p class="partners">We are taking three design partners for real-world deployments — <a href="mailto:contact@datumwise.ai">contact@datumwise.ai</a>.</p>
    </div>
  </section>

  {/* 7 · Standing rows — the six papers, disambiguation, provenance, analytics — live in the footer
       (BaseLayout), kept verbatim. Nothing to add here. */}
</BaseLayout>

<script>
  // #exhibit-a / #exhibit-b anchor shim (homepage v2, Rider 2). These ids used to live on the
  // homepage; the essay that owns them moved to /the-argument, keeping both ids. A config redirect
  // can't help — fragments never reach the server — so anyone who ever shared /#exhibit-b is rewritten
  // here, client-side, to the same anchor on its new home. Both destination ids are preserved.
  const hash = location.hash;
  if (hash === '#exhibit-a' || hash === '#exhibit-b') {
    location.replace('/the-argument' + hash);
  }
  // Unit B: the four-mood witness moved to /the-argument#exhibit-b, so the two ids it used to carry
  // here are rewritten to it. `#try-a-question` was a permanent homepage anchor by rider 1 and had
  // eleven inbound links; all of them now point at the instrument directly, and this catches
  // anything a reader bookmarked or shared before the move.
  if (hash === '#try-a-question' || hash === '#exhibit-a-heading') {
    location.replace('/the-argument#exhibit-b');
  }
</script>

<style>
  /* the legacy boundary — a plain dashed rule, deliberately unstyled: it marks unfinished work */
  .legacy-edge {
    border: 0;
    border-top: 1px dashed var(--rule-strong);
    width: min(100% - 3rem, 68rem);
    margin: 0 auto 3rem;
  }

  .band { padding: clamp(2.5rem, 6vw, 5rem) 0; }
  .prose-col { width: min(100% - 3rem, 46rem); margin-inline: auto; }
  .rule { border: 0; border-top: 1px solid var(--rule); width: min(100% - 3rem, 62rem); margin: 0 auto; }

  /* ── 1 · Masthead ─────────────────────────────────────────────── */
  .masthead { padding-top: clamp(2rem, 5vw, 3.5rem); }
  .mast-grid {
    width: min(100% - 3rem, 62rem); margin-inline: auto;
    display: grid; grid-template-columns: 45fr 55fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center;
  }
  .wordmark { font-size: clamp(2.2rem, 5.5vw, 3.4rem); font-weight: 400; letter-spacing: -0.03em;
    line-height: 1; margin: 0 0 1.1rem; color: var(--ink); }
  /* the description is the page's only long-form line — reading serif, capped 62–68ch, given room. */
  .mast-desc { font-family: var(--font-serif); font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.5; color: var(--ink); max-width: 64ch; margin: 0 0 1.6rem; }
  .mast-install { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap;
    font-family: var(--font-sans); font-size: 0.9rem; margin: 0; }
  .chip { font-family: var(--font-mono); font-size: 0.9rem; background: var(--paper-raised);
    border: 1px solid var(--rule-strong); border-radius: 6px; padding: 0.4rem 0.7rem; color: var(--ink); }
  .mast-quick { color: var(--ink-soft); }
  /* THE DESIGNATED ENTRANCE — hairline rules above and below, no card, no fill, no accent.
     Quiet enough to be furniture, present enough to be the one way in. */
  .start-here { margin-top: 1.8rem; padding: 1rem 0; border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule); max-width: 34rem; }
  .start-label { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--ink-faint); margin: 0 0 0.4rem; }
  .start-title { font-family: var(--font-sans); font-size: 1.02rem; font-weight: 600; color: var(--ink);
    text-decoration: underline; text-decoration-color: var(--rule-strong); display: inline-block; }
  .start-title:hover { text-decoration-color: var(--ink-faint); }
  .start-line { font-family: var(--font-sans); font-size: 0.88rem; color: var(--ink-soft);
    line-height: 1.5; margin: 0.35rem 0 0; }

  .mast-hero { display: flex; flex-direction: column; gap: 0.7rem; }
  .hero-cap { font-size: 0.72rem; color: var(--ink-faint); margin: 0; }

  /* ── 2 · What Columna is ─────────────────────────────────────── */
  .whatis .prose-col > p { font-family: var(--font-serif); font-size: 1.08rem; line-height: 1.62;
    margin: 0 0 1.1rem; }
  .whatis-meta { font-family: var(--font-sans) !important; font-size: 0.9rem !important;
    color: var(--ink-soft); }

  /* the mood vocabulary (Option A, the build default) is defined site-wide in tokens.css — the
     single source, per art direction §3 ("define once, reuse everywhere"). */

  /* ── 3 · Latest rail ─────────────────────────────────────────── */
  .latest { width: min(100% - 3rem, 62rem); margin-inline: auto; padding-block: clamp(1.8rem, 3vw, 2.6rem); }
  .rail-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--ink-faint); margin: 0 0 1rem; }
  .rail { list-style: none; padding: 0; margin: 0; display: grid;
    grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .rail-item { display: flex; flex-direction: column; gap: 0.3rem; font-family: var(--font-sans); }
  .rail-kind { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-faint); }
  .rail-item a { font-size: 0.92rem; line-height: 1.4; color: var(--ink); text-decoration: none;
    border-bottom: 1px solid var(--rule-strong); width: fit-content; }
  .rail-item a:hover { border-color: var(--ink-faint); }
  .rail-date { font-size: 0.75rem; color: var(--ink-faint); }

  /* ── 4 · Try a question ──────────────────────────────────────── */
  .section-h { font-family: var(--font-serif); font-size: clamp(1.4rem, 2.4vw, 1.8rem);
    margin: 0 0 0.7rem; }
  .tryit-lede { font-family: var(--font-sans); font-size: 0.98rem; color: var(--ink-soft);
    margin: 0 0 1.6rem; }
  /* the widget keeps its shipped chrome; restrain the surround to a single hairline frame. */
  .widget-frame { width: min(100% - 3rem, 52rem); margin: 0 auto; border: 1px solid var(--rule);
    padding: clamp(1rem, 3vw, 2rem); }
  .tryit-provenance { font-family: var(--font-mono); font-size: 0.74rem; color: var(--ink-faint);
    line-height: 1.6; margin: 1.2rem auto 0; }

  /* ── 5 · Directory ───────────────────────────────────────────── */
  .directory .section-h { margin-bottom: 1.4rem; }
  .dir-lede { font-family: var(--font-sans); font-size: 0.92rem; color: var(--ink-soft);
    margin: 0 0 1.4rem; }
  /* an ORDERED path: the rung number carries the sequence, hairline separators carry the rhythm.
     No cards, no fills — the ladder is legible from the numbers and the order alone. */
  .dir-list { list-style: none; padding: 0; width: min(100% - 3rem, 46rem); margin: 0 auto;
    display: grid; gap: 0; counter-reset: rung; }
  .dir-item { display: grid; grid-template-columns: 1.9rem 1fr; gap: 0 0.5rem;
    padding: 1rem 0; border-top: 1px solid var(--rule); }
  .dir-item:last-child { border-bottom: 1px solid var(--rule); }
  .dir-rung { font-size: 0.78rem; color: var(--ink-faint); padding-top: 0.15rem; }
  .dir-body { display: grid; gap: 0.2rem; }
  .dir-mark { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--ink-faint); }
  .dir-title { font-family: var(--font-sans); font-size: 1.02rem; font-weight: 600; color: var(--ink);
    text-decoration: underline; text-decoration-color: var(--rule-strong); width: fit-content; }
  .dir-title:hover { text-decoration-color: var(--ink-faint); }
  .dir-blurb { font-size: 0.92rem; color: var(--ink-soft); line-height: 1.5; }

  /* ── 6 · About ───────────────────────────────────────────────── */
  .about-block .prose-col > p { font-family: var(--font-sans); font-size: 0.98rem; line-height: 1.6;
    color: var(--ink-soft); margin: 0 0 0.8rem; }
  .about-block .partners a { color: var(--ink); }

  @media (max-width: 46rem) {
    .mast-grid { grid-template-columns: 1fr; }
    .mast-hero { order: 2; }
    .rail { grid-template-columns: 1fr; gap: 1.1rem; }
  }
</style>
