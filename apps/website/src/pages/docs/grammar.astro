---
// /docs/grammar — THE SHIPPED GRAMMAR REFERENCE. Generated by scripts/gen_grammar.py from
// columna-core itself, so it cannot drift from what ships.
//
// ROUTE (ratified 2026-07-26): a SIBLING of the three manuals, not a section inside one. Generated
// output must not be able to fail a ratified manual's build on a package change, and ratifiable prose
// stays distinct from recomputed content.
//
// The generator derives its three properties from three different artifacts on purpose — a LEXING SET
// IS NOT A GRAMMAR TAXONOMY: structure comes from the parser's docstring (teaching shape), examples
// are executed against the shipped parser (the build fails if any does not parse), and _KW is used
// only to assert that no keyword is silently undocumented.
import BaseLayout from '../../layouts/BaseLayout.astro';
import g from '../../data/grammar.generated.json';

const data = g as any;
const entries = data.entries.filter((e: any) => e.keyword);
const sharedNotes = data.entries.filter((e: any) => !e.keyword);
const examplesFor = (kw: string) => data.examples.filter((x: any) => x.keyword === kw);
// A clause is map-side if it names any of the generator's MAP_CLAUSES tokens.
const isMap = (text: string) =>
  data.frame.map_clauses.some((c: string) => text.includes(c.replace('= <column>', '=')));
---
<BaseLayout title="The shipped grammar — datumwise"
  description="Every keyword the shipped Columna parser accepts, with exact signatures and examples verified against the released package at build time.">
  <div class="page-head">
    <p class="kicker"><a href="/learn">Learn</a> · Reference</p>
    <h1 class="serif">The shipped grammar</h1>
    <p class="lede">Read this before writing a Manifold. Every keyword the <strong>shipped</strong> parser
      accepts, with its exact signature — generated from <code>{data.generated_by}</code> at build time, and
      every example on this page is executed against that parser when the site is built. If an example
      stopped parsing, this page would not exist.</p>
  </div>

  {/* THE FRAME, stated up front rather than as a footnote — this is where a reader most easily forms
      the wrong mental model, so §2b leads. */}
  <section class="frame">
    <p class="frame-label mono">{data.frame.law}</p>
    <p class="frame-text">{data.frame.statement}</p>
    <p class="frame-clauses mono">map-side clauses: {data.frame.map_clauses.join(' · ')}</p>
  </section>

  <section class="prov">
    <p><span class="prov-k mono">structure</span> {data.structure_source}</p>
    <p><span class="prov-k mono">completeness</span> {data.completeness_source}</p>
    <p class="prov-note">{data.note}</p>
  </section>

  {entries.map((e: any) => (
    <section class="kw">
      <h2 class="kw-name mono">{e.keyword}{e.supplemented && <span class="kw-supp mono">supplemented</span>}</h2>
      {e.signatures.map((s: string) => <pre class="sig"><code>{s}</code></pre>)}
      {e.clauses.length > 0 && (
        <div class="clauses">
          <p class="clauses-label mono">inline clauses</p>
          {e.clauses.map((c: string) => (
            <pre class="clause"><code>{c}</code>{isMap(c) && <span class="map-tag mono">map-side</span>}</pre>
          ))}
        </div>
      )}
      {e.notes.map((n: string) => <p class="kw-note">{n}</p>)}
      {examplesFor(e.keyword).map((x: any) => (
        <div class="ex">
          <p class="ex-gloss">{x.gloss}</p>
          <pre class="ex-src"><code>{x.source}</code></pre>
        </div>
      ))}
    </section>
  ))}

  {sharedNotes.length > 0 && (
    <section class="kw">
      <h2 class="kw-name mono">Clauses any declaration may carry</h2>
      {sharedNotes.map((e: any) => e.notes.map((n: string) => (
        <pre class="clause"><code>{n}</code>{isMap(n) && <span class="map-tag mono">map-side</span>}</pre>
      )))}
    </section>
  )}

  <section class="kw">
    <h2 class="kw-name mono">Coverage</h2>
    <p class="kw-note">Every token the parser will accept at the start of a line appears above, as a
      statement or as an inline clause: <span class="mono">{data.kw_tokens.join(' · ')}</span>. The build
      asserts this — a keyword added to the package cannot go silently undocumented here.</p>
  </section>
</BaseLayout>

<style>
  .page-head { width: min(100% - 3rem, 46rem); margin: 0 auto; }
  .page-head h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); margin: 0.3rem 0 0.8rem; }
  .lede { font-size: 1rem; color: var(--ink-soft); max-width: 40rem; line-height: 1.6; }
  .lede code { font-family: var(--font-mono); font-size: 0.88em; }

  .frame { width: min(100% - 3rem, 46rem); margin: 2.2rem auto 0; padding: 1rem 0;
    border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .frame-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--ink-faint); margin: 0 0 0.5rem; }
  .frame-text { font-family: var(--font-serif); font-size: 1rem; line-height: 1.62; margin: 0; }
  .frame-clauses { font-size: 0.74rem; color: var(--ink-faint); margin: 0.7rem 0 0; }

  .prov { width: min(100% - 3rem, 46rem); margin: 1.6rem auto 0; font-size: 0.8rem; color: var(--ink-soft); }
  .prov p { margin: 0.2rem 0; }
  .prov-k { display: inline-block; min-width: 7rem; font-size: 0.68rem; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--ink-faint); }
  .prov-note { margin-top: 0.5rem !important; font-size: 0.78rem; color: var(--ink-faint); font-style: italic; }

  .kw { width: min(100% - 3rem, 46rem); margin: 2.6rem auto 0; padding-top: 1.2rem;
    border-top: 1px solid var(--rule); }
  .kw-name { font-size: 1.05rem; font-weight: 700; letter-spacing: 0.02em; margin: 0 0 0.8rem; }
  .kw-supp { font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.09em;
    color: var(--ink-faint); border: 1px solid var(--rule-strong); padding: 0.1rem 0.4rem;
    margin-left: 0.6rem; vertical-align: middle; font-weight: 400; }
  .sig { background: var(--wire-bg); color: var(--wire-ink); padding: 0.7rem 0.9rem; border-radius: 6px;
    overflow-x: auto; font-size: 0.8rem; line-height: 1.5; margin: 0 0 0.6rem; }
  .clauses { margin: 0.9rem 0 0; }
  .clauses-label { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.09em;
    color: var(--ink-faint); margin: 0 0 0.4rem; }
  .clause { background: var(--paper-raised); padding: 0.45rem 0.7rem; border-radius: 5px;
    font-size: 0.76rem; line-height: 1.5; margin: 0 0 0.35rem; overflow-x: auto;
    display: flex; gap: 0.8rem; align-items: baseline; justify-content: space-between; }
  .map-tag { font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--ink-faint); border: 1px solid var(--rule-strong); padding: 0.05rem 0.35rem;
    border-radius: 3px; flex: none; }
  .kw-note { font-size: 0.88rem; color: var(--ink-soft); line-height: 1.6; margin: 0.7rem 0 0; }
  .ex { margin: 1rem 0 0; }
  .ex-gloss { font-size: 0.85rem; color: var(--ink-soft); margin: 0 0 0.4rem; }
  .ex-src { background: var(--wire-bg); color: var(--wire-ink); padding: 0.8rem 0.95rem;
    border-radius: 6px; overflow-x: auto; font-size: 0.78rem; line-height: 1.55; margin: 0; }
  .sig code, .ex-src code, .clause code { font-family: var(--font-mono); }
</style>
