<script>
  // HISTORICAL FRAGMENT SHIM (item 6). #two-gaps, #can-may and #powers have been live and
  // sitemap-indexed since 21 August 2026 and have NO successor on this page: v2.0 supplies no
  // grounding for the capability/legitimacy matrix or the three powers, and no successor section was
  // fabricated to keep an anchor name alive. They resolve to the preserved material instead.
  //
  // A fragment never reaches the server and this repo's redirects are meta-refresh stubs which do not
  // carry one, so a client-side forward is the only mechanism that preserves a reader's target. Same
  // pattern as the eight legacy /research fragments. Fragmentless /analytical-governance is NOT
  // redirected: it belongs to current reality.
  //
  // THE HEADING IDS COUNT TOO, and this is the finding that made the list longer than the ruling's
  // two entries. Ask builds its citation URLs from HEADING ids, not from section ids, so published
  // answers already point at /analytical-governance#bound-h and #close-h (see
  // services/ask/eval/results/*). Those fragments are as load-bearing as a hand-authored link, and
  // three of them belonged to sections that no longer exist.
  const RETIRED = new Set([
    '#two-gaps', '#can-may', '#powers',          // section ids, live since 21 August 2026
    '#gaps-h', '#matrix-h', '#powers-h',         // the same sections' heading ids
  ]);
  if (RETIRED.has(location.hash)) {
    location.replace('/history/analytical-governance-v1-1' + location.hash);
  }
  // In-page renames: the section still exists here under a v2.0 name, so the reader stays. #bound-h
  // is a heading id whose material became the second half of §Govern the crossings — a real
  // successor, not a section fabricated to keep the name (item 6).
  const RENAMED = { '#serving': '#responses', '#boundaries': '#crossings', '#authorize': '#path',
                    '#bound-h': '#where-this-sits' };
  const to = RENAMED[location.hash];
  if (to) {
    history.replaceState(null, '', location.pathname + to);
    document.querySelector(to)?.scrollIntoView();
  }
</script>

