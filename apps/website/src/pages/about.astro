---
import BaseLayout from '../layouts/BaseLayout.astro';

// Author line is the name only (Huayin's ruling 2026-07-14: no ORCID, no substitute link — the
// DOIs below are the provenance).
const COLUMNAR = 'https://columnar.tech';
// Contact — single swappable string. SWAPPED 2026-07-25 (AW-3 closed): the alias is live, so the
// site's contact is now the domain address. The swappable-const design paid off — this is the only
// place the address is authored, and the sweep found no other surface carrying the old one.
// Note this also RESOLVES a live divergence: llms-full already served `contact@datumwise.ai` via the
// ratified "Two Great Sources" position piece ("Correspondence: …"), so /about and llms-full were
// disagreeing about how to reach us until this line changed.
const CONTACT_EMAIL = 'contact@datumwise.ai';

// THE PUBLICATION LIST IS NO LONGER AUTHORED HERE (Slice 2 item 1, Phase 1A, 2026-08-21).
//
// What stood here was a nine-entry `pubs` array of hand-typed titles and DOIs, maintained by
// remembering to. It had drifted on four of its nine entries: The Theory of Data was listed at v3.1
// (deposited 2026-08-02) when Zenodo had served v6.1 since 2026-08-19; Two Anchors at v1.0 when v2.0
// landed 2026-08-11; The Open Planner at the v1.0 record when v1.3 landed 2026-07-29; the Foundations
// Note at v1.0 when v1.1 landed the same day it was deposited. Each entry carried a careful comment
// explaining its ordering and its wording. None of the comments were wrong. The DOIs were.
//
// That is the whole argument for this change: the defect was not carelessness, it was ARCHITECTURE.
// A fact that must be re-typed to stay true will eventually be false, and a list that documents its
// own editorial reasoning in the margin reads as maintained long after it stopped being. Membership
// and order remain editorial (CHRONOLOGICAL_SELECTION); every fact rendered is read from the registry.
import { CHRONOLOGICAL_SELECTION, currentRecord, displayLabel, doiUrl } from '../data/publications';

const pubs = CHRONOLOGICAL_SELECTION.map((workId) => {
  const record = currentRecord(workId);
  return { label: displayLabel(workId), doi: record.doi, href: doiUrl(record) };
});
---
<BaseLayout title="About — datumwise" description="datumwise is the work of the datumwise team, building and stewarding Columna — the grammar layer for AI analytics.">
  <div class="page-head">
    <p class="kicker">About</p>
    <h1>datumwise</h1>
  </div>

  <article class="prose about">
    <p>
      datumwise is the work of <strong>Huayin Wang</strong>, who researches and builds the grammar layer for analytics, with engineering and infrastructure by <strong>Irena Wang</strong>.
    </p>
    <p class="independence">
      Columna is an independent open-source research project — Huayin Wang (research), Irena Wang (engineering).
    </p>
    <p>
      It builds and stewards <strong>Columna</strong> — an honest data framework: the grammar layer for AI analytics, beside your semantic layer, married to no database.
    </p>
    <p>
      The thinking is public and citable:
    </p>
    <ul class="pubs">
      {pubs.map((p) => (
        <li><em>{p.label}</em> (<a href={p.href} rel="noopener" target="_blank">DOI {p.doi}</a>)</li>
      ))}
    </ul>

    <p class="contact">Contact: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>

    <p class="disambig">
      <strong>Columna is a project of datumwise (datumwise.ai) — not affiliated with Datawise,
      datawise.ai, or columns.ai.</strong> Columna is not a data-cataloguing or
      documentation-generation product; it declares what data means, checks the declaration against
      the data, and refuses what the data cannot answer.
    </p>

    <p class="disambig">
      Not to be confused with <a href={COLUMNAR} rel="noopener" target="_blank">Columnar</a> (columnar.tech), an Arrow-native connectivity layer one letter from our name. <strong>They move columns fast; we govern what columns say.</strong> If anything, the two compose. <a href="/ladder#the-fast-pipe">More on the Ladder →</a>
    </p>
  </article>
</BaseLayout>

<style>
  .about .pubs { list-style: none; padding-left: 0; }
  .about .pubs li { padding: 0.25rem 0; line-height: 1.5; }
  .about .contact { margin-top: 1.4rem; font-size: 0.95rem; color: var(--ink-soft, #555); }
  .about .contact a { color: var(--ink); }
  .about .disambig { margin-top: 1.6rem; padding-top: 1.2rem; border-top: 1px solid var(--wire-rule, #ddd); font-size: 0.95rem; color: var(--ink-soft, #555); }
</style>
