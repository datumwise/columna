---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
// The redesign's shared layer (slice 1) — type scale, rhythm, measures, one accent, focus, and the
// paper/wire register primitives. Loaded after tokens.css because it builds on those registers
// rather than restating them.
import '../styles/redesign.css';
import SiteHeader from '../components/site/SiteHeader.astro';
import AmbientChip from '../components/AmbientChip.astro';
// Vercel Web Analytics (freeze item 13): first-party, cookieless, no PII, no consent banner. v1 scope is
// pageviews + referrers + paths only — no custom events (we're measuring the launch, not building a
// measurement product). Requires Web Analytics enabled on the Vercel project (serves /_vercel/insights/*).
import Analytics from '@vercel/analytics/astro';
// The build stamp resolves through a fallback chain that CANNOT yield an empty string, and fails the
// build loudly if it ever does. See src/lib/buildStamp.ts for the incident this fixes.
import { BUILD_STAMP, BUILD_CHANNEL } from '../lib/buildStamp';
// THE FOOTER EVIDENCE LINE IS DERIVED (Slice 2 item 1, Phase 1A, 2026-08-21). It used to be three
// literal DOIs in the markup below, repeated on every page of the site, and one of the three was
// wrong: Two Anchors v2.0 was deposited 2026-08-11 and the footer went on citing the v1.0 record for
// ten days, on every page, as the site's first evidence link. A fact typed once and rendered
// everywhere is not "single-sourced" — it is single-sourced to a typist.
import { FOOTER_SELECTION, work, currentRecord, doiUrl } from '../data/publications';

const footerEvidence = FOOTER_SELECTION.map((workId) => {
  const record = currentRecord(workId);
  return { label: work(workId).canonicalLabel, doi: record.doi, href: doiUrl(record) };
});

export interface Props {
  title: string;
  description?: string;
  /** Home is a full-bleed argument scroll; inner pages use a centered reading column. */
  wide?: boolean;
  /**
   * The floating `pip install columna` chip. Legacy pages keep it; the redesigned surfaces opt out.
   * It is product-first furniture on an idea-led page, and on the homepage it physically overlapped
   * Exhibit A's paper→wire crossing edge — the one boundary the slice exists to prove.
   */
  chip?: boolean;
}
const {
  title,
  description = 'datumwise builds and stewards Columna — an open-source data framework (Manifold, FrameQL, an honest engine) that refuses to return a confident wrong number.',
  wide = false,
  chip = true,
} = Astro.props;

// The primary navigation moved into <SiteHeader> with the redesign (slice 1): four flat doors —
// The Case · Analytical Governance · Research · Columna — with GitHub as a utility action. The
// previous 6-item nav (Learn · The Case · Positions · Research · The Atlas · GitHub, itself an
// 8 → 6 consolidation on 2026-08-03) is retired from the shell; every one of those pages remains
// live at its URL and reachable from body links. No routes were migrated in this slice.
const year = 2026;

// STRUCTURED IDENTITY (schema.org JSON-LD) — the machine-readable half of the disambiguation row
// (Huayin, 2026-07-29). The prose line in the footer and on /about tells a person we are not Datawise;
// this tells a crawler, in the vocabulary crawlers actually consume.
//
// It is aimed at a specific, measured failure. On 2026-07-29 a search-first assistant answered
// "what is Columna (datumwise.ai)?" with ten pages and sixty-six citations describing a
// "self-documenting semantic layer product from Datumwise/Datawise" — none of the citations ours.
// Forty hours earlier the same engine had found us. Prose alone did not hold that slot; an
// unambiguous @id, a codeRepository, and an explicit non-affiliation line are the cheapest available
// counter-pressure. See specs/baselines/2026-07-29/external_ai_probes/RERUN_INDEX.md.
//
// HOUSE RULE APPLIES HERE TOO: every claim below is one we can defend. No aggregateRating, no
// invented awards, no "company" we are not. The confusable names appear ONLY inside
// disambiguatingDescription — never as alternateName, which would assert the opposite of the point.
const ORIGIN = 'https://datumwise.ai';
const structuredIdentity = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${ORIGIN}/#datumwise`,
      name: 'datumwise',
      url: ORIGIN,
      description:
        'An independent open-source research project — not a company. It builds and stewards Columna, ' +
        'the grammar layer for AI analytics.',
      disambiguatingDescription:
        'datumwise (datumwise.ai) is not affiliated with Datawise, datawise.ai, or columns.ai.',
      email: 'contact@datumwise.ai',
      sameAs: ['https://github.com/datumwise', 'https://github.com/datumwise/columna'],
      member: [
        { '@type': 'Person', name: 'Huayin Wang', jobTitle: 'Research' },
        { '@type': 'Person', name: 'Irena Wang', jobTitle: 'Engineering' },
      ],
    },
    {
      '@type': 'SoftwareSourceCode',
      '@id': `${ORIGIN}/#columna`,
      name: 'Columna',
      url: ORIGIN,
      codeRepository: 'https://github.com/datumwise/columna',
      programmingLanguage: 'Python',
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      author: { '@id': `${ORIGIN}/#datumwise` },
      description:
        'An open-source data framework — a data model (Manifold), a query language (FrameQL), and an ' +
        'engine — built so that no layer of it can return a confident wrong number. Every answer is ' +
        'one of four moods: serve, disclose, clarify, refuse.',
      disambiguatingDescription:
        'Columna is a project of datumwise (datumwise.ai) — not affiliated with Datawise, datawise.ai, ' +
        'or columns.ai. It is not a data-cataloguing or documentation-generation product: it does not ' +
        'write descriptions of your tables. It declares meaning, checks the declaration against the ' +
        'data, and refuses questions the data cannot answer. It is also not Columnar (columnar.tech), ' +
        'the Arrow-native connectivity layer one letter from the name.',
      installUrl: 'https://pypi.org/project/columna/',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Build stamp: makes every deploy's HTML byte-different, so Vercel's edge CDN re-caches every page
        globally on each production deploy — the fix for stale per-PoP static HTML (a pre-#68 /explorer
        head lingered at some edge nodes after the positioning sweep). Prefers the commit SHA; falls
        back through the workflow's export, the runner's GITHUB_SHA, and finally a build timestamp. It
        can never be empty — an empty stamp is what silently disabled this defense before #88. */}
    <meta name="build" content={BUILD_STAMP} />
    {/* Which channel produced these bytes: `preview` (a PR branch build) or `production`.
        A preview must never claim to represent a shipped release; this makes that claim checkable. */}
    <meta name="build-channel" content={BUILD_CHANNEL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {/* Structured identity — see the frontmatter for why this row exists. set:html because Astro
        must emit the JSON verbatim; JSON.stringify output contains no closing-script sequence. */}
    <script type="application/ld+json" set:html={JSON.stringify(structuredIdentity)} is:inline />
    <Analytics />
  </head>
  <body>
    <a href="#main" class="skip visually-hidden">skip to content</a>

    <SiteHeader />

    <main id="main" class={wide ? 'flow-wide' : 'flow'}>
      <slot />
    </main>

    <footer class="footer wayfinding">
      <div class="footer-grid">
        <p class="foot-left">
          Columna is open source, Apache-2.0. The discipline needs no product — declare your anchors,
          name your populations, refuse out loud what your data cannot answer. Columna is our proof
          it can be made executable.
        </p>
        <p class="foot-center">
          {footerEvidence.map((p, i) => (
            <>
              {i > 0 && ' · '}
              <a href={p.href} rel="noopener" target="_blank">{p.label}</a> (DOI {p.doi})
            </>
          ))}
        </p>
        <p class="foot-right"><a href="/about">datumwise builds and stewards Columna.</a></p>
      </div>
      <p class="foot-disambig">
        Not <a href="https://columnar.tech" rel="noopener" target="_blank">Columnar</a> (columnar.tech), the Arrow-native fast pipe one letter away. They move columns fast; we govern what columns say. <a href="/ladder#the-fast-pipe">More →</a>
      </p>
      {/* The confusable-cluster line (Huayin, 2026-07-29), minted from the day-2 probe re-run: an
          external assistant returned a confident 10-page answer describing Columna as a
          "self-documenting semantic layer product from Datumwise/Datawise", sourced entirely from the
          neighbours and citing none of our pages. Cheap to state, serves humans and retrieval alike.
          Names are DELIBERATELY NOT LINKED — the point is to separate from the cluster, not to feed it.
          See specs/baselines/2026-07-29/external_ai_probes/RERUN_INDEX.md, finding 2. */}
      <p class="foot-disambig">
        Columna is a project of datumwise (datumwise.ai) — not affiliated with Datawise, datawise.ai,
        or columns.ai.
      </p>
      <hr class="rule rule-strong" />
      <p class="integrity mono">
        Every transcript and every number on this page is generated at build time by running the
        shipped package. This site is structurally incapable of demoing something it did not ship.
      </p>
      <p class="foot-meta">© {year} datumwise · <a href="/research">Research</a> · <a href="/about">About</a></p>
      {/* Analytics honesty line (freeze item 13, ratified): the brand requires the site say what it does. */}
      <p class="foot-privacy">We count page views without cookies. No personal data, no ads.</p>
    </footer>

    {chip && <AmbientChip />}

    <style>
      .skip:focus { position: fixed; top: 0.5rem; left: 0.5rem; width: auto; height: auto; clip: auto;
        background: var(--ink); color: var(--paper); padding: 0.5rem 0.9rem; z-index: 100; }

      .flow { width: min(100% - 3rem, var(--measure)); margin-inline: auto; }
      .flow-wide { width: 100%; }

      .footer { width: min(100% - 3rem, 68rem); margin: 5rem auto 3rem; font-size: 0.85rem; color: var(--ink-soft); }
      .footer-grid { display: grid; grid-template-columns: 1.4fr 1.6fr 0.8fr; gap: 2rem; align-items: start; }
      .foot-left { margin: 0; max-width: 26rem; }
      .foot-center { margin: 0; font-size: 0.78rem; line-height: 1.7; }
      .foot-center a { color: var(--ink-soft); }
      .foot-right { margin: 0; text-align: right; font-size: 0.8rem; color: var(--ink-faint); }
      .integrity { font-size: 0.78rem; color: var(--ink-soft); line-height: 1.6; max-width: 48rem; }
      .foot-meta { font-size: 0.75rem; color: var(--ink-faint); margin-top: 1.5rem; }
      .foot-privacy { font-size: 0.72rem; color: var(--ink-faint); margin-top: 0.35rem; }
      .foot-meta a { color: var(--ink-faint); }

      @media (max-width: 46rem) {
        .footer-grid { grid-template-columns: 1fr; gap: 1.2rem; }
        .foot-right { text-align: left; }
      }
    </style>
  </body>
</html>
