---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
// The redesign's shared layer (slice 1) — type scale, rhythm, measures, one accent, focus, and the
// paper/wire register primitives. Loaded after tokens.css because it builds on those registers
// rather than restating them.
import '../styles/redesign.css';
// KaTeX's own presentation layer, for the `$$…$$` blocks the corpus carries (astro.config.mjs,
// `markdown.rehypePlugins`). Imported here rather than per-page because BaseLayout wraps every route
// and Astro hoists it into the same bundled stylesheet as the rest — one place, no CDN, no <link> to
// a third party, and it goes out with the build it was tested against.
import 'katex/dist/katex.min.css';
// …and one rule that stylesheet does not decide: overflow behaviour for a display equation wider
// than the reading column. Loads after katex.min.css. See the file for the version-split incident.
import '../styles/katex.css';
import SiteHeader from '../components/site/SiteHeader.astro';
// TWO FOOTERS (Huayin, 2026-08-27, cold-reader cleanup item 3). The global footer was a residue of
// the Columna-centred site — licence, DOIs, columnar.tech, the build-time integrity claim — arriving
// at the bottom of every foundations essay and every datumwise-level surface. It is now a component
// with a `general` (default, small) and a `columna` (the previous rich footer, verbatim) variant.
// See components/site/SiteFooter.astro for what moved, what stayed global, and why.
import SiteFooter from '../components/site/SiteFooter.astro';
import AmbientChip from '../components/AmbientChip.astro';
// Vercel Web Analytics (freeze item 13): first-party, cookieless, no PII, no consent banner. v1 scope is
// pageviews + referrers + paths only — no custom events (we're measuring the launch, not building a
// measurement product). Requires Web Analytics enabled on the Vercel project (serves /_vercel/insights/*).
import Analytics from '@vercel/analytics/astro';
// The build stamp resolves through a fallback chain that CANNOT yield an empty string, and fails the
// build loudly if it ever does. See src/lib/buildStamp.ts for the incident this fixes.
import { BUILD_STAMP, BUILD_CHANNEL } from '../lib/buildStamp';
export interface Props {
  title: string;
  description?: string;
  /** Home is a full-bleed argument scroll; inner pages use a centered reading column. */
  wide?: boolean;
  /**
   * The floating `pip install columna` chip.
   *
   * IT GOES WHERE COLUMNA GOES (Huayin, 2026-08-27, cleanup item 3, extended). It used to be
   * OPT-OUT — on by default, switched off page by page — which meant a `pip install` call to action
   * floated over /about, /learn, /ladder, /story, the positions and every essay that has nothing to
   * install. That is the same residue as the old global footer: Columna's product furniture
   * standing in for datumwise's identity. It is now bound to the Columna context — DEFAULT is
   * `footer === 'columna'` — so opting a page into the Columna estate carries the chip with it and
   * nothing else has to remember.
   *
   * An explicit value still wins, and /columna itself passes `false`: its install path is in the
   * body, and on the homepage the chip physically overlapped Exhibit A's paper→wire crossing edge.
   */
  chip?: boolean;
  /**
   * Which footer closes the page (cleanup item 3, 2026-08-27). `general` is the DEFAULT and the
   * datumwise-level close: copyright, the durable routes, contact, non-affiliation, analytics
   * honesty. `columna` is the previous rich footer — licence, the three DOIs, columnar.tech, the
   * build-time integrity claim, the source repository — and belongs on the Columna estate, where
   * those links are contextual rather than residual. Opting a page in is a decision about what that
   * page IS; do not set it to quiet a layout gap.
   */
  footer?: 'general' | 'columna';
}
const {
  title,
  // DATUMWISE-FIRST (Huayin, 2026-08-27, positioning repair §3). The default that stood here —
  // "datumwise builds and stewards Columna — an open-source data framework (Manifold, FrameQL, an
  // honest engine) that refuses to return a confident wrong number." — defined the project entirely
  // by one of its works, on every page that sets no description of its own (/install, /thesis, /why
  // and others). datumwise is the only thing that needs positioning; this is its ruled identity.
  description = 'datumwise is an independent research project exploring central topics of our time around data, analytics and technology — foundations, languages, and systems for analytics across data, certainty, and intelligence.',
  wide = false,
  chip,
  footer = 'general',
} = Astro.props;
// Default follows the footer variant; an explicit `chip` on the page overrides it.
const showChip = chip ?? footer === 'columna';

// The primary navigation lives in <SiteHeader> (redesign slice 1): three flat doors —
// Foundations · Analytical Governance · Columna. GitHub was a fourth, utility-weight link there
// until 2026-08-27 and is now Columna-contextual (cleanup item 2); the previous 6-item nav
// (Learn · The Case · Positions · Research · The Atlas · GitHub, itself an 8 → 6 consolidation on
// 2026-08-03) is retired from the shell. Every one of those pages remains live at its URL and
// reachable from body links.

// STRUCTURED IDENTITY (schema.org JSON-LD) — the machine-readable half of the disambiguation row
// (Huayin, 2026-07-29). The prose line in the footer and on /about tells a person we are not Datawise;
// this tells a crawler, in the vocabulary crawlers actually consume.
//
// It is aimed at a specific, measured failure. On 2026-07-29 a search-first assistant answered
// "what is Columna (datumwise.ai)?" with ten pages and sixty-six citations describing a
// "self-documenting semantic layer product from Datumwise/Datawise" — none of the citations ours.
// Forty hours earlier the same engine had found us. Prose alone did not hold that slot; an
// unambiguous @id, a codeRepository, and an explicit non-affiliation line are the cheapest available
// counter-pressure. See specs/baselines/2026-07-29/external_ai_probes/RERUN_INDEX.md.
//
// HOUSE RULE APPLIES HERE TOO: every claim below is one we can defend. No aggregateRating, no
// invented awards, no "company" we are not. The confusable names appear ONLY inside
// disambiguatingDescription — never as alternateName, which would assert the opposite of the point.
const ORIGIN = 'https://datumwise.ai';
const structuredIdentity = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${ORIGIN}/#datumwise`,
      name: 'datumwise',
      url: ORIGIN,
      // Datumwise-first, and Columna named as one work among several rather than as the definition
      // of the project (positioning repair §3, 2026-08-27). "Not a company" stays: it is the
      // load-bearing anti-confusion fact this block was minted for.
      description:
        'An independent research project — not a company — exploring central topics of our time ' +
        'around data, analytics and technology. Its work includes the Theory of Data, Analytical ' +
        'Governance, Frame-QL, and Columna.',
      disambiguatingDescription:
        'datumwise (datumwise.ai) is not affiliated with Datawise, datawise.ai, or columns.ai.',
      email: 'contact@datumwise.ai',
      sameAs: ['https://github.com/datumwise', 'https://github.com/datumwise/columna'],
      member: [
        { '@type': 'Person', name: 'Huayin Wang', jobTitle: 'Research' },
        { '@type': 'Person', name: 'Irena Wang', jobTitle: 'Engineering' },
      ],
    },
    {
      '@type': 'SoftwareSourceCode',
      '@id': `${ORIGIN}/#columna`,
      name: 'Columna',
      url: ORIGIN,
      codeRepository: 'https://github.com/datumwise/columna',
      programmingLanguage: 'Python',
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      author: { '@id': `${ORIGIN}/#datumwise` },
      description:
        'Infrastructure for governed analytical service, open source under Apache-2.0: a data model ' +
        '(Manifold), a query language (Frame-QL), and an engine that adjudicates what the declared ' +
        'world and current support entitle it to serve. Every answer is one of four outcomes: ' +
        'serve, disclose, clarify, refuse. The shipped packages are columna-core and columna-server.',
      disambiguatingDescription:
        'Columna is a project of datumwise (datumwise.ai) — not affiliated with Datawise, datawise.ai, ' +
        'or columns.ai. It is not a data-cataloguing or documentation-generation product: it does not ' +
        'write descriptions of your tables. It declares meaning, checks the declaration against the ' +
        'data, and refuses questions the data cannot answer. It is also not Columnar (columnar.tech), ' +
        'the Arrow-native connectivity layer one letter from the name.',
      installUrl: 'https://pypi.org/project/columna/',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Build stamp: makes every deploy's HTML byte-different, so Vercel's edge CDN re-caches every page
        globally on each production deploy — the fix for stale per-PoP static HTML (a pre-#68 /explorer
        head lingered at some edge nodes after the positioning sweep). Prefers the commit SHA; falls
        back through the workflow's export, the runner's GITHUB_SHA, and finally a build timestamp. It
        can never be empty — an empty stamp is what silently disabled this defense before #88. */}
    <meta name="build" content={BUILD_STAMP} />
    {/* Which channel produced these bytes: `preview` (a PR branch build) or `production`.
        A preview must never claim to represent a shipped release; this makes that claim checkable. */}
    <meta name="build-channel" content={BUILD_CHANNEL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {/* Structured identity — see the frontmatter for why this row exists. set:html because Astro
        must emit the JSON verbatim; JSON.stringify output contains no closing-script sequence. */}
    <script type="application/ld+json" set:html={JSON.stringify(structuredIdentity)} is:inline />
    <Analytics />
  </head>
  <body>
    <a href="#main" class="skip visually-hidden">skip to content</a>

    <SiteHeader />

    <main id="main" class={wide ? 'flow-wide' : 'flow'}>
      <slot />
    </main>

    <SiteFooter variant={footer} />

    {showChip && <AmbientChip />}

    <style>
      .skip:focus { position: fixed; top: 0.5rem; left: 0.5rem; width: auto; height: auto; clip: auto;
        background: var(--ink); color: var(--paper); padding: 0.5rem 0.9rem; z-index: 100; }

      .flow { width: min(100% - 3rem, var(--measure)); margin-inline: auto; }
      .flow-wide { width: 100%; }

      /* Footer styles moved with the footer into components/site/SiteFooter.astro (2026-08-27). */
    </style>
  </body>
</html>
