---
/**
 * WireQuotation — PAPER meeting WIRE, once, near the end (brief §10).
 *
 * NOT A SECOND HOMEPAGE DEMO. One controlled encounter whose only job is to prove consequence: the
 * typing argued on this page in prose is observable in a shipped artifact.
 *
 * THE EVIDENCE IS GENERATED, NOT TYPED. `play_crosscheck` is produced by scripts/gen_transcript.py
 * running the SHIPPED package against the demo Manifold, on the deploy path. So the four outcomes
 * below are read out of a real wire, and the claim that `escalate` never appears at the machine
 * boundary is checked at build time against those same bytes rather than asserted in copy. If the
 * shipped contract ever grew an escalate outcome, this build would fail rather than this page
 * quietly continuing to claim otherwise.
 *
 * PRECISION, DELIBERATELY. The page does NOT claim the outcome field has exactly four values: the
 * contract also carries `error`, which this site has ruled is not a mood but a neutral machine
 * fault (tokens.css, 2026-07-26). The claim made here is the true and narrower one — the four
 * serving moods are present, and Escalate is absent, because Escalate is not a serving verdict.
 *
 * "Wire inside paper is a quotation from wire, not a dark product panel pasted into the page."
 * So: one narrow quotation block, the crossing edge stated at its top, and no chrome.
 */
import transcript from '../../data/transcript.generated.json';

const meta = (transcript as any).meta ?? {};
const crosscheck: Array<{ title: string; wire: any }> = (transcript as any).play_crosscheck ?? [];

if (crosscheck.length !== 4) {
  throw new Error(
    `AG wire quotation: expected 4 crosscheck entries from the shipped package, got ${crosscheck.length}. ` +
    'The four serving moods are the claim this block exists to evidence; it must not render a partial set.',
  );
}

const SERVING = ['serve', 'disclose', 'clarify', 'refuse'];
const observed = crosscheck.map((c) => c.wire?.outcome);
for (const mood of SERVING) {
  if (!observed.includes(mood)) {
    throw new Error(
      `AG wire quotation: the shipped package did not produce a "${mood}" outcome (got ${JSON.stringify(observed)}). ` +
      'This page claims the four serving moods are exposed at the machine boundary; it may not claim it unevidenced.',
    );
  }
}

// The absence claim, checked against the generated bytes rather than trusted.
if (JSON.stringify(transcript).toLowerCase().includes('escalate')) {
  throw new Error(
    'AG wire quotation: the word "escalate" appears in the generated transcript. This page states that ' +
    'Escalate does not appear at the machine serving boundary. Re-check the shipped contract before ' +
    'letting the page keep that sentence.',
  );
}

// Ordered as the page argues them, not as the demo happens to run them.
const rows = SERVING.map((mood) => {
  const entry = crosscheck.find((c) => c.wire?.outcome === mood)!;
  return { mood, contract: entry.wire.contract_version };
});
---

<section id="wire" class="wire-q ds ds-paper ds-section" aria-labelledby="wire-h">
  <div class="ds-measure-wide">
    <h2 id="wire-h" class="ds-label">Product consequence</h2>

    <p class="ds-proposition">The typing is not only argued. It ships.</p>

    <div class="cols">
      <div class="prose-col">
        <p class="ds-body">
          Analytical Governance is a category, not a product. But a category that no system has ever
          embodied is a proposal, and the distinction this page turns on is testable in one place:
          what a governed engine is actually willing to return.
        </p>
        <p class="ds-body">
          Columna exposes exactly the four serving moods at its machine boundary. <strong>Escalate is
          not among them</strong> &mdash; not because it was left out, but because it is not a
          serving verdict. It is what happens when the governed world cannot resolve the request at
          all, and that is a governance action, not a response.
        </p>
        <p class="ds-body">
          The block beside this is read from a transcript generated by running the shipped package,
          on the deploy path. Nothing in it is transcribed by hand, and the absence of
          <code class="ds-mark">escalate</code> is verified at build time rather than claimed in copy.
        </p>
      </div>

      <figure class="quotation">
        <figcaption class="q-cap">
          <span class="q-crossing">Quoted from the wire</span>
          <span class="q-meta">columna {meta.columna} &middot; contract {meta.contract_version} &middot; manifold {meta.manifold}</span>
        </figcaption>
        <div class="q-body ds-wire vocab-wire">
          <ol class="q-rows">
            {rows.map((r) => (
              <li class="q-row">
                <span class="q-key">"outcome"</span><span class="q-punct">:</span>
                <span class="q-val">"{r.mood}"</span>
              </li>
            ))}
            <li class="q-row q-absent">
              <span class="q-key">"outcome"</span><span class="q-punct">:</span>
              <span class="q-val q-none">"escalate"</span>
              <span class="q-note">&mdash; never at this boundary</span>
            </li>
          </ol>
        </div>
      </figure>
    </div>

    <p class="onward">
      <a class="ds-link" href="/columna">The system that embodies this &rarr;</a>
      <a class="ds-link" href="/explorer">The demo Manifold, live &rarr;</a>
    </p>
  </div>
</section>

<style>
  .ds-proposition { max-width: 20ch; margin-bottom: var(--ds-space-4); }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 1rem + 5vw, 5rem);
    align-items: start;
  }
  .prose-col .ds-body { margin: 0 0 var(--ds-space-2); max-width: 50ch; }
  .prose-col strong { color: var(--ink); font-weight: 600; }

  .quotation { margin: 0; }
  .q-cap { display: grid; gap: 0.2rem; margin-bottom: 0.6rem; }
  .q-crossing {
    font-family: var(--font-sans);
    font-size: var(--ds-meta);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .q-meta { font-family: var(--font-mono); font-size: var(--ds-mono-sm); color: var(--ink-soft); }

  /* The crossing has a LOCATION: a stated edge at the top of the quotation, never a fade. This is a
     quotation block sitting in paper — it is deliberately narrow, unchromed, and does not span the
     page like a product panel would. */
  .q-body {
    border-top: 1px solid var(--ink);
    padding: 1.1rem 1.2rem;
  }
  .q-rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .q-row {
    font-family: var(--font-mono);
    font-size: var(--ds-mono);
    line-height: 1.5;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.35rem;
  }
  .q-key { color: var(--wire-key); }
  .q-punct { color: var(--wire-ink-soft); }
  .q-val { color: var(--wire-string); }

  /* The absent line is shown STRUCK, not coloured: it is the one row that is not there. */
  .q-absent { margin-top: 0.55rem; padding-top: 0.75rem; border-top: 1px dashed var(--wire-rule); }
  .q-none { text-decoration: line-through; text-decoration-thickness: 1px; color: var(--wire-ink-soft); }
  .q-note { color: var(--wire-ink-soft); font-size: var(--ds-mono-sm); }

  .onward { margin: var(--ds-space-5) 0 0; display: flex; flex-wrap: wrap; gap: 1.5rem; }

  @media (max-width: 56rem) {
    .cols { grid-template-columns: 1fr; gap: var(--ds-space-4); }
    .ds-proposition { max-width: none; }
  }
</style>
