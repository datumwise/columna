---
/**
 * SiteHeader — the global shell for the redesign (implementation brief §4).
 *
 * Four flat doors, no dropdowns, no mega-menu. `Analytical Governance` is never shortened to
 * `Governance`: in this market bare "governance" already means stewardship/access/compliance, and
 * the whole point of the category is that it concerns the validity and authority of analytical
 * claims instead (positioning §4).
 *
 * GitHub is a UTILITY action — visually secondary to the doors, never a fifth door.
 *
 * Navigation hierarchy does not require URL hierarchy (positioning §10), so these hrefs are the
 * canonical destinations, not a folder tree.
 *
 * NO-JS: the mobile menu is a <details> disclosure. It opens, closes, and is keyboard-operable
 * with JavaScript disabled, and the same four doors are inside it — no nested information
 * architecture, nothing hidden behind an intellectual hierarchy.
 */
const DOORS = [
  { label: 'The Case', href: '/case' },
  { label: 'Analytical Governance', href: '/analytical-governance' },
  { label: 'Research', href: '/research' },
  { label: 'Columna', href: '/columna' },
];
const GITHUB = 'https://github.com/datumwise/columna';
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => here === href || here.startsWith(href + '/');
---

<header class="shell ds ds-paper">
  <a href="/" class="wordmark">datumwise</a>

  <nav class="doors" aria-label="Primary">
    {DOORS.map((d) => (
      <a href={d.href} aria-current={isCurrent(d.href) ? 'page' : undefined}>{d.label}</a>
    ))}
  </nav>

  <div class="utility">
    <a href={GITHUB} rel="noopener" target="_blank">GitHub</a>
  </div>

  <details class="menu">
    <summary aria-label="Menu"><span aria-hidden="true">Menu</span></summary>
    <nav class="sheet" aria-label="Primary, compact">
      {DOORS.map((d) => (
        <a href={d.href} aria-current={isCurrent(d.href) ? 'page' : undefined}>{d.label}</a>
      ))}
      <a class="util" href={GITHUB} rel="noopener" target="_blank">GitHub</a>
    </nav>
  </details>
</header>

<style>
  .shell {
    display: flex;
    align-items: baseline;
    gap: var(--ds-space-4);
    padding: 1.1rem var(--ds-gutter);
    border-bottom: 1px solid var(--ds-rule);
    font-family: var(--font-sans);
  }
  .wordmark {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    letter-spacing: 0.01em;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
  }
  .doors { display: flex; gap: var(--ds-space-3); }
  .doors a,
  .utility a {
    font-size: var(--ds-meta);
    color: var(--ink-soft);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
    white-space: nowrap;
  }
  .doors a:hover { color: var(--ink); border-bottom-color: var(--ds-rule-strong); }
  /* the current door is marked by rule + ink, not by colour alone */
  .doors a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--ink); }
  .utility { padding-left: var(--ds-space-3); border-left: 1px solid var(--ds-rule); }
  .utility a { color: var(--ink-faint); }
  .utility a:hover { color: var(--ink); }

  .menu { display: none; }
  .menu summary {
    list-style: none;
    cursor: pointer;
    font-size: var(--ds-meta);
    color: var(--ink-soft);
    border-bottom: 1px solid var(--ds-rule-strong);
    padding-bottom: 2px;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu[open] summary { color: var(--ink); }
  .sheet { display: flex; flex-direction: column; gap: 0.85rem; padding: 1.1rem 0 0.25rem; }
  .sheet a {
    font-size: 1rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ds-rule);
    padding-bottom: 0.5rem;
  }
  .sheet a.util { color: var(--ink-faint); font-size: var(--ds-meta); border-bottom: 0; }

  /* Compact shell. The same four doors move into the sheet — nothing is demoted or nested. */
  @media (max-width: 56rem) {
    .shell { flex-wrap: wrap; gap: var(--ds-space-2); }
    .doors, .utility { display: none; }
    .menu { display: block; }
    .menu[open] { width: 100%; }
  }
</style>
