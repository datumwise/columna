---
// The hero manifold (homepage v2, Group 3). Renders the HERO preset generated by
// scripts/gen_universe_visual.py from the SHIPPED package — same source of truth as Figure 1 on
// /case, so it cannot drift. It authors no geometry of its own; the SVG string is trusted because it
// comes from our own build-time generator, never user input.
//
// Motion (art direction §1): the paths stroke in ONCE on first paint (~1.2s), then static. No loop —
// a loop reads as brand video; a single draw reads as a computation that just happened.
// prefers-reduced-motion: reduce → no animation, the finished figure is shown immediately.
import uv from '../data/universe_visual.generated.json';
const hero = (uv as any).hero_svg as string;
---
<div class="hero-manifold" data-hero-manifold set:html={hero}></div>

<style>
  .hero-manifold { width: 100%; }
  .hero-manifold :global(svg) { display: block; width: 100%; height: auto; overflow: visible; }

  /* The one-time draw-in. Strokes are dashed to their own length and offset, then the offset animates
     to 0 — the classic "draw a line" reveal — running ONCE (no iteration). Text and chip fills fade in
     just behind the strokes. Guarded by a class the script adds only when motion is allowed. */
  .hero-manifold.is-drawing :global(line),
  .hero-manifold.is-drawing :global(rect) {
    stroke-dasharray: var(--len, 600);
    stroke-dashoffset: var(--len, 600);
    animation: hero-draw 1.2s ease-out forwards;
  }
  .hero-manifold.is-drawing :global(text) {
    opacity: 0;
    animation: hero-fade 0.5s ease-out 0.7s forwards;
  }
  @keyframes hero-draw { to { stroke-dashoffset: 0; } }
  @keyframes hero-fade { to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    /* belt-and-braces: even if the class were added, never animate under reduced motion. */
    .hero-manifold.is-drawing :global(line),
    .hero-manifold.is-drawing :global(rect),
    .hero-manifold.is-drawing :global(text) { animation: none; stroke-dashoffset: 0; opacity: 1; }
  }
</style>

<script>
  // Add the draw-in class only when motion is allowed AND the hero is about to be seen. Dashed frontier
  // lines carry their own stroke-dasharray for the dotted look; the draw animation would fight that, so
  // those are left out of the reveal (they simply appear) — only solid strokes draw in.
  const root = document.querySelector<HTMLElement>('[data-hero-manifold]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && !reduce) {
    // measure each drawable so its dash length matches its own geometry (a short seam and a long
    // frontier draw at the same *rate*, not the same duration jump).
    root.querySelectorAll<SVGGeometryElement>('line:not([stroke-dasharray]), rect').forEach((el) => {
      try {
        const len = el.getTotalLength ? el.getTotalLength() : 600;
        el.style.setProperty('--len', String(Math.ceil(len)));
      } catch { /* getTotalLength unsupported → fall back to the default in CSS */ }
    });
    root.classList.add('is-drawing');
  }
</script>
