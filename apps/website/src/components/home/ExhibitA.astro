---
/**
 * ExhibitA — section 3, and the first true PAPER → WIRE crossing (implementation brief §7).
 *
 * The crossing has a LOCATION: a stated boundary line and a hard edge, never a dissolve. Paper and
 * wire are jurisdictions, not themes; a crossfade would read as ambient mood lighting instead of as
 * the event it is — principle has become executable consequence.
 *
 * CAUSALITY (Gate H4): four DIFFERENT requests earned four different verdicts. The mood index
 * focuses a case; it never picks a verdict for one unchanged request. Every case travels with the
 * request and governed context that earned it.
 *
 * PROGRESSIVE ENHANCEMENT (Gate H7): all four cases are in the HTML before any script runs. The
 * index is a list of in-page anchors, which works with JavaScript disabled and with a keyboard. On
 * wide viewports the script upgrades that list into an ARIA tablist that focuses one case at a
 * time; if the script never runs, the page is four stacked cases and loses nothing but compactness.
 *
 * TRUTH: every request, verdict, code, detail and row below is generated by running the shipped
 * package (src/lib/exhibitA.ts → transcript.generated.json → scripts/gen_transcript.py). Nothing
 * here is illustrative.
 */
import GovernedCase from './GovernedCase.astro';
import { CASES, PROVENANCE } from '../../lib/exhibitA';
---

{/* ── PAPER side of the crossing ─────────────────────────────────────────────────────────── */}
<section class="lead ds ds-paper ds-section" aria-labelledby="exhibit-a-heading">
  <div class="ds-measure-wide lead-grid">
    <div>
      <h2 id="exhibit-a-heading" class="ds-label">Exhibit A · Columna as evidence</h2>
      <p class="ds-proposition">
        A computable answer is not automatically an answer entitled to be served.
      </p>
    </div>
    <div class="lead-side">
      <p class="causality">Four requests. Four earned verdicts. No options. Outcomes follow from meaning.</p>
      <p class="links">
        <a class="ds-link" href="/case">Why this matters → The Case</a>
        <a class="ds-link" href="/columna">Explore Columna →</a>
      </p>
    </div>
  </div>
</section>

{/* ── THE CROSSING ───────────────────────────────────────────────────────────────────────── */}
<div class="crossing ds ds-paper" aria-hidden="true">
  <div class="ds-measure-wide crossing-inner">
    <span class="from">principle</span>
    <span class="rule"></span>
    <span class="to">executable consequence</span>
  </div>
</div>

{/* ── WIRE side of the crossing ──────────────────────────────────────────────────────────── */}
{/* `try-a-question` is a PERMANENT ANCHOR (homepage v2, Huayin's rider 1), re-seated here.
    It is the address of "the running demo" — the four-mood witness — and it is linked from
    /ladder (10 links: 5 prose claims + 5 fate-matrix cells), /install and /how-to-read-the-wire.
    Exhibit A IS the four-mood witness now, so the anchor belongs on the wire block that shows
    the four governed verdicts. It broke once before as #exhibit-b and again in slice 1 when the
    moods widget was retired; a comment did not hold it, so scripts/check_fragments.mjs now fails
    the build if any internal #fragment does not resolve. Move this id only WITH that check green. */}
<section
  id="try-a-question"
  class="wire ds ds-wire ds-crossing ds-section"
  aria-labelledby="cases-heading"
  data-exhibit-a
>
  <div class="ds-measure-wide">
    <div class="wire-head">
      <h3 id="cases-heading" class="ds-label">Four governed cases, executed</h3>
      <p class="provenance ds-mono-sm">
        manifold {PROVENANCE.manifold} · columna {PROVENANCE.columna} · core {PROVENANCE.core} ·
        contract {PROVENANCE.contract} — generated by running the shipped package at build time
      </p>
    </div>

    {/* The mood index. Anchors first: they work without JavaScript and with a keyboard. */}
    <nav class="index" aria-label="Governed cases" data-mood-index>
      {CASES.map((c) => (
        <a href={`#case-${c.mood}`} data-mood-link={c.mood}>{c.mood}</a>
      ))}
    </nav>

    <div class="cases" data-cases>
      {CASES.map((c, i) => <GovernedCase data={c} index={i} />)}
    </div>
  </div>
</section>

<script>
  /**
   * Progressive enhancement ONLY. Everything this script does is compactness: it hides three of
   * four cases that are already in the document and gives the index proper tab semantics. With the
   * script removed the page still carries all four cases, in order, reachable by anchor and by
   * keyboard — which is the requirement (all four cases exist in semantic HTML).
   *
   * It deliberately does nothing below the wide breakpoint: on a phone the stacked form IS the
   * safer default, because scrolling past four cases makes the causality obvious in a way a tab
   * strip cannot.
   */
  const WIDE = window.matchMedia('(min-width: 56.0625rem)');
  const root = document.querySelector('[data-exhibit-a]');
  const index = root?.querySelector<HTMLElement>('[data-mood-index]');
  const cases = Array.from(root?.querySelectorAll<HTMLElement>('.case') ?? []);
  const links = Array.from(index?.querySelectorAll<HTMLAnchorElement>('[data-mood-link]') ?? []);

  if (root && index && cases.length === links.length && cases.length > 0) {
    const select = (i: number, focus = false) => {
      links.forEach((l, n) => {
        l.setAttribute('aria-selected', String(n === i));
        l.tabIndex = n === i ? 0 : -1;
      });
      cases.forEach((c, n) => { c.hidden = n !== i; });
      if (focus) links[i].focus();
    };

    const enhance = () => {
      index.setAttribute('role', 'tablist');
      links.forEach((l, n) => {
        l.setAttribute('role', 'tab');
        l.setAttribute('aria-controls', cases[n].id);
        cases[n].setAttribute('role', 'tabpanel');
        cases[n].setAttribute('aria-labelledby', `${cases[n].id}-tab`);
        l.id = `${cases[n].id}-tab`;
      });
      select(0);
      index.dataset.enhanced = 'true';
    };

    const relax = () => {
      index.removeAttribute('role');
      delete index.dataset.enhanced;
      links.forEach((l) => {
        l.removeAttribute('role'); l.removeAttribute('aria-selected');
        l.removeAttribute('aria-controls'); l.tabIndex = 0;
      });
      cases.forEach((c) => { c.hidden = false; c.removeAttribute('role'); });
    };

    links.forEach((l, n) => {
      l.addEventListener('click', (e) => {
        if (!WIDE.matches) return;             // narrow: let the anchor scroll to the real case
        e.preventDefault();
        select(n);
      });
      l.addEventListener('keydown', (e) => {
        if (!WIDE.matches) return;
        const delta = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!delta) return;
        e.preventDefault();
        select((n + delta + links.length) % links.length, true);
      });
    });

    const apply = () => (WIDE.matches ? enhance() : relax());
    apply();
    WIDE.addEventListener('change', apply);
  }
</script>

<style>
  .lead-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 0.8rem + 3vw, 4rem);
    align-items: end;
  }
  .lead { padding-bottom: var(--ds-space-5); }
  .causality {
    font-family: var(--font-serif);
    font-size: var(--ds-lead);
    line-height: 1.35;
    color: var(--ink-soft);
    margin: 0;
    text-wrap: balance;
  }
  .links { display: flex; gap: var(--ds-space-3); margin: var(--ds-space-3) 0 0; flex-wrap: wrap; }

  /* THE CROSSING EDGE — a located boundary, not a fade. The words name what is being crossed. */
  .crossing { padding: 0 var(--ds-gutter); }
  .crossing-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.1rem;
    font-family: var(--font-sans);
    font-size: var(--ds-meta);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .crossing .rule { flex: 1; height: 1px; background: var(--ds-rule-strong); }
  .crossing .to { color: var(--ink-soft); }

  .wire { padding-inline: var(--ds-gutter); }
  .wire-head { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; align-items: baseline; }
  .provenance { color: var(--wire-ink-soft); margin: 0 0 var(--ds-space-3); }

  /* Mood controls: state labels, not product tabs. No pills, no rounded segmented control. */
  .index { display: flex; gap: clamp(1rem, 0.5rem + 2vw, 2.5rem); flex-wrap: wrap; }
  .index a {
    font-family: var(--font-mono);
    font-size: var(--ds-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--wire-ink-soft);
    text-decoration: none;
    padding-bottom: 0.45rem;
    border-bottom: 2px solid transparent;
  }
  .index a:hover { color: var(--wire-ink); }
  .index[data-enhanced] a { cursor: pointer; }
  .index a[aria-selected='true'] { color: var(--ds-accent-wire); border-bottom-color: var(--ds-accent-wire); }
  /* Without the script every mood is an equal, live anchor — the underline appears on hover only. */
  .index:not([data-enhanced]) a:hover { border-bottom-color: var(--wire-rule); }

  .cases { margin-top: 0; }

  @media (max-width: 56rem) {
    .lead-grid { grid-template-columns: 1fr; align-items: start; }
    /* The index becomes a sticky mini-index that scrolls to the real cases; it never swaps them
       out of the DOM. */
    .index {
      position: sticky;
      top: 0;
      z-index: 2;
      background: var(--wire-bg);
      padding: 0.75rem 0 0.35rem;
      border-bottom: 1px solid var(--wire-rule);
      gap: 1.1rem;
    }
    .index a { font-size: var(--ds-mono-sm); }
  }
</style>
